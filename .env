# ============================================================
# AJK Real Estate — Environment Configuration
# ============================================================
# INSTRUCTIONS:
#   1. Copy this file to your project root (same folder as index.html & api.php)
#   2. Fill in your real values below
#   3. NEVER commit this file to Git — add .env to .gitignore
# ============================================================

# ── Database ─────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_NAME=ajkrealstate
DB_USER=root
DB_PASS=

# ── App Settings ─────────────────────────────────────────────
APP_NAME=AJK Real Estate
APP_ENV=development
# development | production

# ── Login Credentials ────────────────────────────────────────
# These are checked inside auth.js (frontend) for simplicity.
# For production, move to a real sessions-based PHP login.
ADMIN_USER=admin
ADMIN_PASS=ajk2025

# ── Optional: Email (for future notifications) ───────────────
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=your@email.com
MAIL_PASS=yourpassword
MAIL_FROM=noreply@ajkrealstate.pk

# ── Optional: WhatsApp Business API ─────────────────────────
WA_API_KEY=
WA_PHONE_ID=
